rules_version = '2';

// Original uploaded documents live at:
//   businesses/{businessId}/documents/{documentId}/{fileName}
// Uploads are performed by the FastAPI backend (Admin SDK) after validation.
// Clients may only read files of businesses they are a member of.
service firebase.storage {
  match /b/{bucket}/o {

    function isMember(businessId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/businessMembers/$(businessId + '_' + request.auth.uid));
    }

    match /businesses/{businessId}/documents/{documentId}/{fileName} {
      allow read: if isMember(businessId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
