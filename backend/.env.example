# Copy to backend/.env and fill in. NEVER commit backend/.env or any service-account JSON.
# Real environment variables override values in this file.

APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true on Cloud Run for structured logs
CORS_ORIGINS=http://localhost:3000

# --- Firebase (server-side, Admin SDK) ---------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Absolute path to a service-account key stored OUTSIDE this repository, e.g.
#   /Users/you/.config/vyaparai/firebase-admin.json
# Leave empty on Cloud Run: the service's attached service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# Local emulators (no credentials, demo project). Never enable in production.
FIREBASE_USE_EMULATORS=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Document ingestion -------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760       # 10 MB
OCR_PROVIDER=tesseract          # tesseract | none   (Tesseract: `brew install tesseract`)
OCR_LANGUAGES=eng               # e.g. eng+hin after `brew install tesseract-lang`
TESSERACT_CMD=                  # only if tesseract isn't on PATH
EXTRACTION_PROVIDER=rules       # rules | llm (llm not configured yet; falls back to rules)
PDF_TEXT_STRATEGY=auto          # auto = text layer first, OCR for scanned pages | ocr = always OCR

# --- Google Gemini (not used yet) ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ChromaDB (not used yet) --------------------------------------------------------------
CHROMA_PERSIST_DIR=./.chroma
